{
  "name": "oliver-downloader",
  "version": "0.1.4",
  "description": "App desktop local para baixar videos publicos do YouTube.",
  "main": "out/main/index.js",
  "author": "Oliver Downloader",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "postinstall": "electron-builder install-app-deps",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json && electron-vite build",
    "preview": "electron-vite preview",
    "dist": "pnpm build && electron-builder",
    "rebuild:native": "electron-builder install-app-deps",
    "prepare:binaries": "node scripts/prepare-binaries.mjs",
    "prepare:binaries:win": "node scripts/prepare-binaries.mjs --target=win32"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffmpeg-installer/win32-x64": "^4.1.0",
    "@radix-ui/react-slot": "^1.2.3",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.oliver.downloader",
    "productName": "Oliver Downloader",
    "asarUnpack": [
      "**/*.node",
      "resources/bin/**",
      "node_modules/@ffmpeg-installer/**"
    ],
    "files": [
      "out/**/*",
      "resources/bin/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "pimentellima",
      "repo": "oliver-downloader",
      "releaseType": "release"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@ffmpeg-installer/darwin-arm64",
      "@ffmpeg-installer/win32-x64",
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
